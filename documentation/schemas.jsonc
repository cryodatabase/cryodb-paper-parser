                    "value": 97.0
                }, 
                "unit": "%", 
                "quote": "Different Me₂SO concentration (V/V) of 3%, 5%, 7%, 8%, 10%, 15%, 20%, dissolved in cell culture medium", 
                "note": null
            }
        ]
    }]  
}